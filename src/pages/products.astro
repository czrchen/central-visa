---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout path="/products" title="Products — Central Vista Snacks & Confectionery">
  <PageHeader eyebrow={"Our products"} title={"Everything we make"} subtitle={"From marshmallows and corn snacks to chocolate confectionery \u2014 the full Central Vista and CV Mallow range. OEM and private-label production welcome."} />


                  <div class="pcard-media"><img src="/images/products/marshmallow.jpg" alt="Marshmallow" loading="lazy" width="600" height="400" /></div>
                  <h3>Marshmallow</h3>
                  <span class="flip-hint">Hover for details ↻</span>
                </div>
                <div class="pcard-face pcard-back">
                  <span class="back-cat">Marshmallow</span>
                  <h3>Marshmallow</h3>
                  <p>Soft, fluffy classic marshmallows.</p>
                  <span class="flip-hint light">↩ flip back</span>
                </div>
              </div>
            </article>
            <article class="pcard" tabindex="0">
              <div class="pcard-flip">
                <div class="pcard-face pcard-front">

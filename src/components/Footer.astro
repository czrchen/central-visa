---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <img class="brand-mark" src="/images/logo/logo.png" alt="Central Vista — Since 1993" width="60" height="60" />
        <span class="brand-text">Central Vista</span>
      </a>
      <p>Snacks &amp; confectionery manufactured in Johor, Malaysia since 1993 — trusted by 100+ clients across the world.</p>
      <div class="socials">
        <a href="#" aria-label="Facebook">Facebook</a>
        <a href="#" aria-label="Instagram">Instagram</a>
        <a href="#" aria-label="YouTube">YouTube</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/products">Products</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Our Brands</h4>
      <a href="/products">CV Corn Snacks</a>
      <a href="/products">CV Mallow Marshmallow</a>
      <a href="/products">Cereal Bars &amp; Cookies</a>
      <a href="/products">Chocolate Confectionery</a>
    </div>

    <div class="footer-col">
      <h4>Get in touch</h4>
      <p class="muted">21, 23, 25 Jalan Bukit 1, Kawasan MIEL, Bandar Seri Alam, 81750 Johor Bahru, Malaysia</p>
      <a href="tel:+6073863241">607-386 3241 / 3242</a>
      <a href="mailto:export@central-vista.com">export@central-vista.com</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Central Vista (M) Sdn Bhd · Co. No. 267337-W</span>
    <span>Johor Bahru, Malaysia</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--ink);
    color: #C9CBDD;
    margin-top: 110px;
    padding: 70px 0 30px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.4fr;
    gap: 40px;
  }
  .brand { display: flex; align-items: center; gap: 13px; margin-bottom: 18px; }
  .brand-mark { width: 56px; height: 56px; object-fit: contain; }
  .brand-text { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: #fff; letter-spacing: -0.02em; }
  .footer-brand p { color: #9A9DB5; max-width: 320px; font-size: .95rem; line-height: 1.6; }

  .socials { display: flex; gap: 18px; margin-top: 22px; }
  .socials a {
    font-size: .88rem; font-weight: 500; color: #9A9DB5;
    transition: color .2s ease;
  }
  .socials a:hover { color: var(--gold); }

  .footer-col h4 {
    font-family: var(--font-display); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
    margin-bottom: 18px; color: #6F7290;
  }
  .footer-col a { display: block; color: #C9CBDD; padding: 6px 0; font-size: .95rem; transition: color .18s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-col .muted { color: #9A9DB5; margin-bottom: 14px; font-size: .95rem; line-height: 1.6; }

  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-top: 54px; padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #6F7290; font-size: .86rem;
  }

  @media (max-width: 860px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 30px; }
  }
</style>

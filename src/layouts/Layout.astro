---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const {
  title = "Central Vista — Happy Snacks & Confectionery from Malaysia",
  description = "Central Vista (M) Sdn Bhd manufactures corn snacks, marshmallows, cereal bars, cookies and chocolate confectionery in Johor, Malaysia. Trusted by 100+ clients worldwide.",
  path = "/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo/logo01.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav path={path} />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function revealAll() {
        gsap.set("[data-reveal]", { opacity: 1, y: 0 });
        gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((g) =>
          gsap.set(g.children, { opacity: 1, y: 0 }));
      }

      function initMotion() {
        if (reduce) { revealAll(); return; }

        // Hero entrance — text slides up, art pops in
        gsap.timeline({ defaults: { ease: "power3.out" } })
          .from("[data-hero-stagger] > *", {
            y: 28, opacity: 0, duration: 0.85, stagger: 0.09,
          })
          .from("[data-hero-art] > *", {
            scale: 0.9, opacity: 0, duration: 0.9, stagger: 0.12, ease: "back.out(1.5)",
          }, "-=0.55");

        // Scroll reveals
        gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
          gsap.to(el, {
            y: 0, opacity: 1, duration: 0.8, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 92%", once: true },
          });
        });

        // Staggered groups — pop in with a gentle overshoot
        gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
          const kids = group.children;
          gsap.set(kids, { y: 34, opacity: 0, scale: 0.95 });
          ScrollTrigger.create({
            trigger: group,
            start: "top 90%",
            once: true,
            onEnter: () => {
              gsap.to(kids, {
                y: 0, opacity: 1, scale: 1, duration: 0.7, stagger: 0.09, ease: "back.out(1.3)",
              });
            },
          });
        });

        // Gentle continuous float (e.g. certification logos)
        gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
          gsap.to(el, {
            y: -9,
            duration: 2 + (i % 4) * 0.25,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
            delay: i * 0.18,
          });
        });

        // Parallax — elements drift as they scroll through the viewport
        gsap.utils.toArray<HTMLElement>("[data-parallax]").forEach((el) => {
          const amt = parseFloat(el.getAttribute("data-parallax") || "24");
          gsap.fromTo(el, { y: amt }, {
            y: -amt, ease: "none",
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: 0.5 },
          });
        });

        // Count-up stats
        gsap.utils.toArray<HTMLElement>("[data-count]").forEach((el) => {
          const target = Number(el.dataset.count || "0");
          const obj = { val: 0 };
          gsap.to(obj, {
            val: target, duration: 1.8, ease: "power2.out",
            scrollTrigger: { trigger: el, start: "top 92%", once: true },
            onUpdate: () => { el.textContent = Math.round(obj.val).toString(); },
          });
        });

        // Recalculate trigger positions once everything (incl. fonts/images) settles
        ScrollTrigger.refresh();
        window.addEventListener("load", () => ScrollTrigger.refresh());
        setTimeout(() => ScrollTrigger.refresh(), 1200);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMotion);
      } else {
        initMotion();
      }
    </script>
  </body>
</html>
